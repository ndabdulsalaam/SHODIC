# Django Core - staging template
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_ENV=staging
SECRET_KEY=replace-with-staging-secret
ALLOWED_HOSTS=staging-api.example.com
ALLOWED_ORIGINS=https://staging-rxchat.example.com,https://staging-fildah.example.com

# Database - staging database or Neon/Postgres branch, never production
DATABASE_URL=postgresql://user:password@host:5432/staging_db
DATABASE_SSL_REQUIRE=True

# AI - use staging-safe keys or quotas where possible
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB - use a separate staging collection
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat_staging

# Email/OAuth - use staging-safe settings and callbacks
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME_RXCHAT=RxChat Staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
