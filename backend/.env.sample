# Django Core - dev/local template
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ENV=dev
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
# Use a dev PostgreSQL/Neon branch for serious schema work.
# If DATABASE_URL is omitted in dev, Django falls back to backend/db.sqlite3.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# AI - OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB + Embeddings - Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
# QDRANT_COLLECTION and QDRANT_INFERENCE_MODEL have defaults in settings/base.py
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat_dev

# Brevo Email API (brevo.com - for OTP delivery)
# BREVO_SENDER_NAME_RXCHAT defaults to 'RxChat' in settings/base.py
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME_RXCHAT=RxChat

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
