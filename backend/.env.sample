# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
# Leave DATABASE_URL blank for SQLite fallback. Set it for Neon/Postgres.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
DATABASE_CONN_MAX_AGE=0

# AI - OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL_FALLBACK=baidu/qianfan-ocr-fast:free
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB + Embeddings - Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat_dev
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
QDRANT_SPARSE_MODEL=qdrant/bm25
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# Data acquisition and feature flags
OPENFDA_API_KEY=
RXCHAT_ATTACHMENTS_ENABLED=False

# Django-Q cluster
Q_CLUSTER_WORKERS=1
Q_CLUSTER_TIMEOUT=14400
Q_CLUSTER_RETRY=14500

# Brevo Email API (brevo.com - for OTP delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME_DEFAULT=Fildah
BREVO_SENDER_NAME_RXCHAT=RxChat
DEFAULT_FROM_EMAIL=RxChat <noreply@rxchat.dev>

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
