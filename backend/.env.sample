# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173

# Database (Neon Postgres — neon.tech)
DATABASE_URL=

# AI — OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vector DB + Embeddings — Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
# QDRANT_COLLECTION and QDRANT_INFERENCE_MODEL have defaults in settings.py
QDRANT_URL=
QDRANT_API_KEY=

# Brevo Email API (brevo.com — for OTP delivery)
# BREVO_SENDER_NAME defaults to 'RxChat' in settings.py
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
