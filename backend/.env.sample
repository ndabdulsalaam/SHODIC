# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173

# Database (Neon Postgres — neon.tech)
DATABASE_URL=

# AI — Default LLM provider (nvidia | deepseek | openrouter)
DEFAULT_LLM_PROVIDER=nvidia

# AI — NVIDIA NIM (build.nvidia.com → DeepSeek v3.2)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI — DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI — OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# Vector DB + Embeddings — Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat_drugs

# Brevo Email API (brevo.com — for OTP delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RxChat

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
