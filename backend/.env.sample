# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],rxchat.dev,www.rxchat.dev,rxchat-backend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rxchat.dev,https://www.rxchat.dev
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_BACKEND_URL=http://localhost:8000
FRONTEND_URL=https://rxchat.dev
BACKEND_EXTERNAL_URL=https://rxchat-backend.onrender.com

# Database (Neon Postgres — neon.tech)
DATABASE_URL=

# AI — OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB + Embeddings — Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
# QDRANT_COLLECTION and QDRANT_INFERENCE_MODEL have defaults in settings.py
QDRANT_URL=
QDRANT_API_KEY=

# Brevo Email API (brevo.com — for OTP delivery)
# BREVO_SENDER_NAME defaults to 'RxChat' in settings.py
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rxchat-backend.onrender.com/api/auth/google/callback/
GOOGLE_REDIRECT_URIS=http://localhost:8000/api/auth/google/callback/,https://rxchat-backend.onrender.com/api/auth/google/callback/
