# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=rxchat.dev,www.rxchat.dev,rxchat-backend.onrender.com
ALLOWED_ORIGINS=https://rxchat.dev,https://www.rxchat.dev
FRONTEND_URL=https://rxchat.dev
BACKEND_EXTERNAL_URL=https://rxchat-backend.onrender.com

# Database (Neon Postgres — neon.tech)
DATABASE_URL=

# AI — OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB + Embeddings — Qdrant Cloud (cloud.qdrant.io)
# Embeddings are handled by Qdrant Cloud Inference (no separate API needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat_drugs
QDRANT_INFERENCE_MODEL=

# Brevo Email API (brevo.com — for OTP delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RxChat

# Google OAuth (optional — console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rxchat-backend.onrender.com/api/auth/google/callback/
