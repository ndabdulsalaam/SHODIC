# Django Core - production template
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ENV=production
SECRET_KEY=replace-with-production-secret
ALLOWED_HOSTS=api.fildah.com
ALLOWED_ORIGINS=https://rxchat.fildah.com,https://fildah.com

# Database - production only
DATABASE_URL=postgresql://user:password@host:5432/production_db
DATABASE_SSL_REQUIRE=True

# AI - production keys
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_REASONING_MAX_TOKENS=4096

# Vector DB - production collection
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rxchat

# Email/OAuth - production settings and callbacks
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME_RXCHAT=RxChat
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
